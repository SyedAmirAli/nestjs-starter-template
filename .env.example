# glowquest backend — environment.
#
# Copy to .env and fill in. Every key without a default is validated at boot by
# src/config/validate.ts: in production a missing one is fatal, in development it warns and
# the affected integration degrades. There are no silent defaults for anything below.

NODE_ENV=development
PORT=4000
HOST=0.0.0.0
APP_NAME=glowquest
APP_VERSION=1.0.0

# Public origin of this API. Used for deep links in notifications and as the OAuth redirect base.
APP_BASE_URL=http://localhost:4000

# Allowed browser origins, comma-separated. `*` reflects whatever origin asks, which with
# credentials is strictly MORE permissive than a wildcard — any site a signed-in user visits
# can call this API as them. The production client is a native app and is not subject to CORS
# at all, so set real origins (or an empty list) before production.
# CORS_ORIGINS=https://glowquest.app,https://admin.glowquest.app
CORS_ORIGINS=*

# --- Database ---------------------------------------------------------------
# DATABASE_URL wins outright when set. The decomposed parts exist so a container can override
# only the host: DATABASE_URL hardcodes "localhost", which inside a container resolves to the
# container itself, not the host. See docker-compose.yml.
#
# First-time setup (needs a superuser, creates the role, database and extensions):
#   sudo -u postgres psql -f scripts/db-bootstrap.sql
# SHADOW_DATABASE_URL is only used by `prisma migrate dev`: it needs a scratch database to
# diff the schema against, and the app role is NOCREATEDB so it cannot create one itself.
# db-bootstrap.sql creates it.
DATABASE_URL="postgresql://glowquest:CHANGE_ME@localhost:5432/glowquest_backend?schema=public"
SHADOW_DATABASE_URL="postgresql://glowquest:CHANGE_ME@localhost:5432/glowquest_backend_shadow?schema=public"
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=glowquest_backend
DATABASE_USERNAME=glowquest
DATABASE_PASSWORD=CHANGE_ME

# --- Auth -------------------------------------------------------------------
# Generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:4000

# Must match `scheme` in the mobile app's app.json — it is how OAuth returns to the app.
EXPO_SCHEME=glowquest

# Sign-in with Google. Scopes: openid email profile — NOT gmail.compose, which is requested
# incrementally the first time a user creates an application draft. Do not merge the two.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REDIRECT_URI=http://localhost:4000/api/auth/callback/google
# Google issues one client id per platform; native sign-in returns a token signed for the
# iOS/Android client, which the web id alone would reject.
# GOOGLE_OAUTH_CLIENT_ID_IOS=
# GOOGLE_OAUTH_CLIENT_ID_ANDROID=

# --- AI ---------------------------------------------------------------------
# Any OpenAI-compatible provider — OpenRouter, OmniRoute, or OpenAI itself. AI_BASE_URL is the
# root the SDK appends /chat/completions to. Model ids must be spelled the way the chosen
# provider spells them: OpenRouter namespaces them (anthropic/claude-sonnet-4.5), OpenAI does not.
AI_API_KEY=
AI_BASE_URL=https://openrouter.ai/api/v1
AI_MODEL_PRIMARY=anthropic/claude-sonnet-4.5
AI_MODEL_FAST=anthropic/claude-haiku-4.5
# Hard ceiling on total monthly AI spend across all users. Enforced from the model_calls
# ledger, not a counter — see TelemetryService.spendSince.
AI_MONTHLY_COST_CAP_USD=200

# --- Object storage (S3-compatible: Cloudflare R2 in prod, MinIO in dev) -----
# The bucket is PRIVATE. No public read, no public listing — every access is a presigned URL.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Namespace inside a possibly-shared bucket. Every object key is rooted here.
S3_PREFIX=glowquest
# Only for deliberately-public assets. User content is never public, so this normally stays unset.
# S3_PUBLIC_BASE_URL=

# --- Redis (queues + cache + rate limits, one instance, separate logical DBs) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
# REDIS_URL=redis://localhost:6379/0

# Run BullMQ workers inside the API process. Defaults to true outside production, where
# workers normally run as a dedicated pool. A single-container deploy must set this to true
# or queued jobs are enqueued and never consumed.
# RUN_WORKERS_IN_PROCESS=true

# Lets an operator start a downed Redis from the API. Off by default: starting a service is
# privileged and the mechanism is deployment-specific.
#   none    (default) status only
#   command run a local command — dev / bare metal, where Redis shares the API's OS
#   docker  drive a Redis *container* via a bind-mounted /var/run/docker.sock
#   agent   ask a host-side helper — the right answer when the API is containerized
# REDIS_CONTROL_DRIVER=none
# REDIS_CONTROL_START_CMD=systemctl start redis-server
# REDIS_CONTROL_RESTART_CMD=systemctl restart redis-server
# REDIS_CONTROL_DOCKER_CONTAINER=glowquest-redis
# REDIS_CONTROL_AGENT_URL=http://172.17.0.1:9099
# REDIS_CONTROL_AGENT_TOKEN=

# --- Backups ----------------------------------------------------------------
# 32 bytes, base64. A backup archive is the user's entire account in one file, so it is
# encrypted before it ever reaches storage.
# Generate with: openssl rand -base64 32
BACKUP_ENCRYPTION_KEY=

# --- Mail (OTP codes) -------------------------------------------------------
# For Gmail, MAIL_APP_PASSWORD is an App Password from the Google Account's "App passwords"
# settings — not the account password. Requires 2-Step Verification on the account.
MAIL_FROM=
MAIL_APP_PASSWORD=
# MAIL_LOGO_URL=

# --- Uploads ----------------------------------------------------------------
# Mirrors the reverse proxy's client_max_body_size. Not enforced by the app — used at boot to
# detect a profile that permits more than the proxy will ever deliver, which otherwise
# surfaces as an unexplained 413 with no app log at all.
# UPLOAD_PROXY_BODY_LIMIT_BYTES=134217728
# UPLOAD_DOCUMENT_MAX_BYTES=10485760

# --- Observability ----------------------------------------------------------
# HTTP_LOG=false      # disable the access log entirely
# NO_COLOR=1          # strip ANSI from log output
# SWAGGER_ENABLED=true  # expose /docs in production (off by default — it enumerates the API)
