DATABASE_URL="postgresql://db_user:db_password@localhost:5432/db_name?schema=public"

# Decomposed form of the DATABASE_URL above — used by docker-compose.yml, which
# substitutes DATABASE_HOST with host.docker.internal (DATABASE_URL itself can't be
# used there: it hardcodes "localhost", which means something different inside a
# container). Not read by the app locally since DATABASE_URL takes precedence — see
# src/config/dotenv.ts. Keep these in sync with DATABASE_URL above if it ever changes.
DATABASE_USERNAME=
DATABASE_PASSWORD=
DATABASE_PORT=5432
DATABASE_NAME=

# Redis, same reasoning — not read locally (the app already defaults to these same
# values), only used by docker-compose.yml alongside REDIS_HOST=host.docker.internal.
REDIS_PASSWORD=
REDIS_PORT=6379
REDIS_DB=0

BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://dev.syedamirali.me

# GOOGLE O_AUTH CREDENTIALS
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${BETTER_AUTH_URL}/api/auth/google/callback"

# OPENROUTER API KEY
AI_API_KEY=
AI_BASE_URL=

# AI models (OpenRouter ids). Vision MUST be multimodal.
AI_VISION_MODEL=google/gemini-3.1-flash-lite   # was gemini-2.5-flash — newer gen, cheaper ($0.25/$1.50 vs $0.30/$2.50)
AI_OCR_MODEL=google/gemini-3.1-flash-lite       # was gemini-2.5-pro — ~6x cheaper blended ($0.50 vs $3.00/1M)
AI_CHAT_MODEL=google/gemini-3.1-flash-lite      # unchanged — already on the efficient frontier
# Speech-to-text (OpenRouter /audio/transcriptions). Turbo = faster/cheaper Whisper.
AI_STT_MODEL=openai/whisper-large-v3-turbo      # unchanged — cheapest STT on OpenRouter (~$0.04/hr)
AI_OCR_MODEL=google/gemini-3-flash   # middle ground — $1.00 blended, still 3x cheaper than 2.5-pro

# Cloudflare R2 - S3 compatable API
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCESS_KEY_ID=
CLOUDFLARE_SECRET_ACCESS_KEY=
CLOUDFLARE_S3_API=
CLOUDFLARE_BUCKET_NAME=files
CLOUDFLARE_BUCKET_PREFIX=test